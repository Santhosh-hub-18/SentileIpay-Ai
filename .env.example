# FraudShield Environment Configuration
# NOTICE: FraudShield is a simulation dashboard for hackathon PS-002.
# All data, SMS messages, phone verification calls, and transaction blocks are simulated.

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration
# Automatically falls back to SQLite (fraudshield.db) if DATABASE_URL is not set
DB_BACKEND=sqlite
DATABASE_URL=sqlite:///./fraudshield.db

# Authentication Secrets (Development Defaults - Replace in Production)
JWT_SECRET_KEY=fraudshield-super-secret-jwt-key-2026-hackathon-ps002
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo Analyst Credentials
DEMO_ANALYST_USER=analyst
DEMO_ANALYST_PASSWORD=FraudShield2026!

# Demo Admin Credentials (can edit risk settings)
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=AdminShield2026!
